// Copia questo file in Secrets.xcconfig (stessa cartella) e compila i valori.
//
// Nelle xcconfig "//" apre un commento: negli URL scrivi https:/$()/ invece di
// https:// - Xcode sostituisce $() con una stringa vuota.
//
// Usa SOLO la chiave pubblica (publishable/anon) di Supabase: la protezione dei
// dati e' la RLS. La service role key non deve mai finire nell'app.

SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_KEY = sb_publishable_xxxxxxxxxxxxxxxx
API_BASE_URL = https:/$()/your-site.netlify.app/api

// Firma e identificativo, per installare su un dispositivo.
// DEVELOPMENT_TEAM = ABCDE12345
// APP_BUNDLE_ID = com.tuodominio.pricetracker
